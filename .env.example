# DAI Experiment Platform — 生产环境配置示例
# 复制为 .env 并修改所有默认值

DAI_ENVIRONMENT=production
DAI_DATABASE_URL=mysql+pymysql://dai:change_me@mysql:3306/dai_platform
DAI_REDIS_URL=redis://redis:6379/0
DAI_SECRET_KEY=change-me-to-a-random-64-char-string
DAI_CORS_ORIGINS=http://your-domain.com
# 直接连接 API 的反向代理/LB CIDR，逗号分隔；只填写学校部署拓扑中实际可信的 peer。
# 留空仅适合首次配置检查，正式多人使用前必须按 README 配置；禁止填 0.0.0.0/0。
DAI_TRUSTED_PROXY_CIDRS=
# 文件日志（容器内路径固定 /app/logs，挂载于 app_logs 卷；管理员系统日志页读取）
DAI_LOG_DIR=/app/logs
# Storage backend is provider-neutral; production may use an S3-compatible
# service while keeping the same logical object keys.
DAI_STORAGE_BACKEND=local
# DAI_STORAGE_BACKEND=s3
# DAI_STORAGE_S3_ENDPOINT_URL=https://object-storage.example.com
# DAI_STORAGE_S3_BUCKET=dai-platform
# DAI_STORAGE_S3_REGION=us-east-1
# DAI_STORAGE_S3_ACCESS_KEY_ID=
# DAI_STORAGE_S3_SECRET_ACCESS_KEY=
# DAI_STORAGE_S3_SESSION_TOKEN=
# DAI_STORAGE_S3_ADDRESSING_STYLE=auto
# DAI_STORAGE_S3_KEY_PREFIX=
# disposable 默认标签；生产只接受已 smoke 的完整 repository@sha256 Registry 引用
DAI_JUDGE_IMAGE=dai-judge-python:latest
# Kernel 镜像——仅用于未绑定环境版本的存量兼容路径；已绑定环境版本的实验记录
# 使用环境版本 digest 启动（Phase 5 起，`latest` 标签不再作为运行环境来源）
DAI_KERNEL_IMAGE=dai-kernel-python:latest
DAI_JUDGE_TIMEOUT_SECONDS=30
DAI_JUDGE_MEMORY_LIMIT_MB=256
DAI_JUDGE_CPU_LIMIT=1.0
# 必须填写宿主机绝对路径；API/Worker 会把该目录挂载到判题容器
DAI_JUDGE_HOST_WORK_DIR=/absolute/path/to/dai-experiment-platform/judge-work
DAI_ACCESS_TOKEN_EXPIRE_MINUTES=30
DAI_REFRESH_TOKEN_EXPIRE_DAYS=7

# 教师上传视频（容器内路径需与 docker-compose.prod.yml 的 video_data 卷挂载一致）
DAI_VIDEO_STORAGE_DIR=/app/storage/videos
DAI_VIDEO_MAX_UPLOAD_BYTES=524288000
DAI_VIDEO_PLAYBACK_URL_TTL_SECONDS=3600

# 课程封面上传（容器内路径需与 docker-compose.prod.yml 的 cover_data 卷挂载一致）
DAI_COVER_STORAGE_DIR=/app/storage/covers
DAI_COVER_MAX_UPLOAD_BYTES=5242880

# Docker Compose
DAI_DB_ROOT_PASSWORD=change_me_root
DAI_DB_USER=dai
DAI_DB_PASSWORD=change_me
FRONTEND_PORT=8080
# 这些是当前已审核的 manifest digest；学校部署机若使用镜像仓库镜像/不同架构，必须重新
# pull/inspect 后替换为对应真实 digest，禁止使用占位值。
DAI_MYSQL_IMAGE=mysql:8.0@sha256:7dcddc01f13bab2f15cde676d44d01f61fc9f99fe7785e86196dfc07d358ae2b
DAI_REDIS_IMAGE=redis:7-alpine@sha256:e7723ff73d963f5cc6d9c4643ea3d989527a402a319239054e9472a7fb9219a2
DAI_BACKEND_BASE_IMAGE=python:3.12-slim@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36
DAI_FRONTEND_NODE_BASE_IMAGE=node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293
DAI_FRONTEND_NGINX_BASE_IMAGE=nginx:alpine@sha256:4a73073bd557c65b759505da037898b61f1be6cbcc3c2c3aeac22d2a470c1752
DAI_JUDGE_BASE_IMAGE=python:3.12-slim@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36
DAI_KERNEL_BASE_IMAGE=python:3.12-slim@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36
# 全新库 bootstrap 必须提供已验证的 basic 镜像 digest；不要填写 000...、111... 或 disposable 值。
# DAI_BASIC_ENVIRONMENT_IMAGE_DIGEST=sha256:<64位真实hex>
# DAI_BASIC_ENVIRONMENT_BASE_IMAGE=python:3.12-slim@sha256:<64位真实hex>
DAI_MIGRATION_MODE=production

# ── 环境档位控制面（Legacy + Editor V2）──────────────────
# V2 关闭时生产 DAI_ENV_BASE_IMAGE 必须带 @sha256: digest；V2 开启时改用下方三版本 digest 映射。
# 获取方式：docker pull python:3.12-slim && docker image inspect python:3.12-slim --format "{{index .RepoDigests 0}}"
# 注意：digest 是内容寻址，服务器拉取的镜像必须与示例一致；首次部署请用服务器本地镜像的实际 digest 覆盖
DAI_ENV_BASE_IMAGE=python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de
DAI_ENV_BUILD_QUEUE_NAME=environment:build:queue
DAI_ENV_BUILD_TIMEOUT_SECONDS=3600
DAI_ENV_IMAGE_REPOSITORY=dai-env
DAI_ENV_BUILD_LOG_MAX_BYTES=61440
# V2 默认关闭；生产启用前为三个 Python 版本分别填入真实 digest
DAI_ENVIRONMENT_EDITOR_V2_ENABLED=false
# V2 构建成功必须推送并回拉校验 Registry digest；生产开启 V2 时必填。
# 可使用 registry.example/dai-env 或 registry.example:5000/dai-env 形式，不要填 tag。
DAI_ENV_REGISTRY_REPOSITORY=registry.example/dai-env
# Docker config.json Secret（只允许 auths；不要提交真实凭据）。Compose 默认读取
# deploy/registry-docker-config.example.json，生产请改为宿主机 root-owned 文件。
DAI_ENV_REGISTRY_DOCKER_CONFIG_FILE=./deploy/registry-docker-config.example.json
DAI_ENV_REGISTRY_ALLOW_ANONYMOUS=false
# DAI_ENV_PYTHON_BASE_IMAGES={"3.10":"python:3.10-slim-bookworm@sha256:<64位hex>","3.11":"python:3.11-slim-bookworm@sha256:<64位hex>","3.12":"python:3.12-slim-bookworm@sha256:<64位hex>"}
# DAI_ENV_APT_SNAPSHOT_SOURCES={"3.10":["deb http://snapshot.debian.org/archive/debian/20260801T000000Z bookworm main"],"3.11":["deb http://snapshot.debian.org/archive/debian/20260801T000000Z bookworm main"],"3.12":["deb http://snapshot.debian.org/archive/debian/20260801T000000Z bookworm main"]}
DAI_ENV_PLATFORM_PYTHON_PACKAGES={"ipykernel":"6.29.5","pytest":"8.3.4"}
DAI_ENV_PLATFORM_BUNDLE_VERSION=v1
DAI_ENV_BUILD_NETWORK_MODE=default
DAI_ENV_BUILD_HTTP_PROXY=
DAI_ENV_BUILD_CPU_LIMIT=2
DAI_ENV_BUILD_MEMORY_MB=4096
DAI_ENV_BUILD_PIDS_LIMIT=512
DAI_ENV_BUILD_MAX_IMAGE_BYTES=21474836480
DAI_ENV_BUILDER_HEARTBEAT_KEY=environment:v2:builder:heartbeat
DAI_ENV_BUILDER_HEARTBEAT_TTL_SECONDS=30
DAI_ENV_BUILDER_HEARTBEAT_INTERVAL_SECONDS=10
# 仅一次性、已备份的迁移测试库允许设置；生产环境不要设置。
# DAI_ALLOW_ENVIRONMENT_V2_DOWNGRADE=true

# AI 智能代码评分（DeepSeek）
# 审批完成前保持关闭；需要启用时必须完成 docs/ai-data-governance.md 的上线门。
DAI_AI_ENABLED=false
DAI_AI_BASE_URL=https://aihub.codingpython.cn
DAI_AI_API_KEY=
DAI_AI_MODEL=deepseek-v4-flash
DAI_AI_TIMEOUT_SECONDS=60
DAI_AI_MAX_RETRIES=3
DAI_AI_TEST_GROUP_TIMEOUT_SECONDS=120
DAI_AI_TEST_GROUP_MAX_RETRIES=0
DAI_AI_QUEUE_NAME=judge:ai:queue
